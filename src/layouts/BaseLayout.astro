---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AosController from '../components/AosController.astro';
import CommercialContextController from '../components/CommercialContextController.astro';
import CyberdayPopup from '../components/CyberdayPopup.astro';
import WhatsAppConversion from '../components/WhatsAppConversion.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  pageClass?: string;
}

const {
  title = 'EVAAS Commerce · Activación Digital',
  description = 'Presencia digital profesional, clara y lista para evolucionar.',
  noindex = false,
  pageClass = ''
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const pagePath = Astro.url.pathname.replace(/\/$/, '') || '/';
const showCyberdayPopup = !['/terminos', '/privacidad', '/confirmacion'].includes(pagePath);
---

<!doctype html>
<html lang="es-CL" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#0B0B0C" />
    <script is:inline>
      (() => {
        const themeColors = { dark: '#0b0b0c', light: '#f5f7f8', cyan: '#062e38' };
        let theme = 'dark';
        try {
          const saved = localStorage.getItem('evaas-commerce-theme');
          if (Object.hasOwn(themeColors, saved)) theme = saved;
        } catch { /* Storage unavailable: retain the contractual dark default. */ }
        document.documentElement.dataset.theme = theme;
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', themeColors[theme]);
      })();
    </script>
    <noscript><style>.theme-switcher { display: none !important; }</style></noscript>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_CL" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <title>{title}</title>
  </head>
  <body class={pageClass}>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <AosController />
    <CommercialContextController />
    <WhatsAppConversion />
    {showCyberdayPopup && <CyberdayPopup />}
    <script is:inline>
      (() => {
        window.__evaasTrackQueue = window.__evaasTrackQueue || [];
        window.evaasTrack = (name, detail = {}) => window.__evaasTrackQueue.push([name, detail]);
      })();
    </script>
  </body>
</html>
