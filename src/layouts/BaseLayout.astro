---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  pageClass?: string;
}

const {
  title = 'EVAAS Station · Activación Digital',
  description = 'Una presencia digital profesional, clara y preparada para evolucionar.',
  noindex = false,
  pageClass = ''
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#0B0B0C" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_CL" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <title>{title}</title>
  </head>
  <body class={pageClass}>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      (() => {
        const allowedEvents = new Set([
          'product_viewed', 'demo_opened', 'demo_completed', 'plan_compared',
          'product_selected', 'activation_started', 'activation_submitted', 'activation_completed',
          'activation_error', 'selector_completed'
        ]);
        const params = new URLSearchParams(location.search);
        const attribution = {
          source: params.get('utm_source') || sessionStorage.getItem('evaas_source') || 'direct',
          campaign: params.get('utm_campaign') || sessionStorage.getItem('evaas_campaign') || '',
          medium: params.get('utm_medium') || sessionStorage.getItem('evaas_medium') || ''
        };
        Object.entries(attribution).forEach(([key, value]) => {
          if (value) sessionStorage.setItem(`evaas_${key}`, value);
        });
        window.evaasAttribution = attribution;
        window.evaasTrack = (name, detail = {}) => {
          if (!allowedEvents.has(name)) return;
          const payload = { event: name, ...attribution, ...detail, path: location.pathname, device: innerWidth < 768 ? 'mobile' : 'desktop' };
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push(payload);
          window.dispatchEvent(new CustomEvent('evaas:track', { detail: payload }));
        };
        document.addEventListener('click', (event) => {
          const target = event.target.closest('[data-track]');
          if (!target) return;
          const detail = {};
          if (target.dataset.product) detail.product = target.dataset.product;
          if (target.dataset.demo) detail.demo = target.dataset.demo;
          window.evaasTrack(target.dataset.track, detail);
          if (target.dataset.product) sessionStorage.setItem('evaas_selected_product', target.dataset.product);
        });
      })();
    </script>
    <script is:inline>
      (() => {
        const context = document.modelContext;
        if (!context?.registerTool) return;
        const products = {
          landing: { name: 'Landing', path: '/activar/landing', reason: 'Una propuesta principal en un recorrido directo.' },
          catalogo: { name: 'Catálogo', path: '/activar/catalogo', reason: 'Varias opciones organizadas para explorar y consultar.' },
          corporativa: { name: 'Web Corporativa', path: '/activar/corporativa', reason: 'Una empresa con varias áreas e información institucional.' }
        };
        const validProduct = (value) => {
          if (!Object.prototype.hasOwnProperty.call(products, value)) throw new Error('Configuración no válida.');
          return value;
        };
        const controller = new AbortController();
        Promise.resolve(context.registerTool({
          name: 'recommend_station_configuration',
          title: 'Recomendar configuración',
          description: 'Recomienda Landing, Catálogo o Web Corporativa según lo que se necesita presentar. No solicita datos personales ni inicia una compra.',
          inputSchema: {
            type: 'object',
            properties: {
              need: { type: 'string', enum: ['one_offer', 'multiple_offers', 'organization'] },
              ecommerce: { type: 'boolean' }
            },
            required: ['need', 'ecommerce'],
            additionalProperties: false
          },
          annotations: { readOnlyHint: true, untrustedContentHint: false },
          execute(input) {
            if (!input || typeof input !== 'object') throw new Error('Entrada no válida.');
            if (input.ecommerce === true) return { inScope: false, reason: 'EVAAS Station no incluye ecommerce.' };
            const map = { one_offer: 'landing', multiple_offers: 'catalogo', organization: 'corporativa' };
            const slug = map[input.need];
            if (!slug) throw new Error('Necesidad no válida.');
            return { inScope: true, slug, ...products[slug] };
          }
        }, { signal: controller.signal })).catch(() => {});
        Promise.resolve(context.registerTool({
          name: 'start_station_activation',
          title: 'Comenzar activación',
          description: 'Abre el formulario visible para la configuración elegida. No envía información ni realiza un pago.',
          inputSchema: {
            type: 'object',
            properties: { product: { type: 'string', enum: ['landing', 'catalogo', 'corporativa'] } },
            required: ['product'],
            additionalProperties: false
          },
          annotations: { readOnlyHint: false, untrustedContentHint: false },
          execute(input) {
            const slug = validProduct(input?.product);
            sessionStorage.setItem('evaas_selected_product', slug);
            location.assign(products[slug].path);
            return { started: true, product: slug };
          }
        }, { signal: controller.signal })).catch(() => {});
      })();
    </script>
  </body>
</html>
