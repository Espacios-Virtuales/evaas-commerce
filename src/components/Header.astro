<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="EVAAS Station, ir al inicio">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="64"
        height="64"
        viewBox="0 0 64 64"
        role="img"
        aria-labelledby="ev-logo-title"
        class="brand-icon"
      >
        <title id="ev-logo-title">Espacios Virtuales</title>

        <!-- Contorno abierto -->
        <path
          d="M52 24 V18 L32 6 L11 18 V46 L32 58 L52 46 V40"
          fill="none"
          stroke="#69D0D4"
          stroke-width="4.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>

        <!-- Trazos de la E: desde el borde interior hasta el nodo -->
        <path
          d="M13.25 28 H27 M13.25 32 H27 M13.25 36 H27"
          fill="none"
          stroke="#69D0D4"
          stroke-width="1.8"
          stroke-linecap="butt"></path>

        <!-- Nodo central -->
        <rect x="27" y="27" width="10" height="10" rx="1" fill="#69D0D4"></rect>
      </svg>
      <span class="text-brand"><strong>EVAAS</strong><em>Commerce</em></span>
    </a>
    <nav class="desktop-nav" aria-label="Navegación principal">
      <a href="/#showroom">Demos</a>
      <a href="/#elegir">Elegir</a>
      <a href="/#comparar">Comparar</a>
      <a href="/#como-funciona">Cómo funciona</a>
    </nav>
    <div
      class="theme-switcher"
      role="group"
      aria-label="Tema de EVAAS Commerce"
    >
      <button type="button" data-theme-choice="dark" aria-pressed="true"
        >Dark</button
      >
      <button type="button" data-theme-choice="light" aria-pressed="false"
        >Light</button
      >
      <button type="button" data-theme-choice="cyan" aria-pressed="false"
        >Cyan</button
      >
    </div>
    <a class="button button-small button-light" href="/#elegir">Ver opciones</a>
    <details class="mobile-menu">
      <summary aria-label="Abrir menú"><span></span><span></span></summary>
      <nav aria-label="Navegación móvil">
        <a href="/#showroom">Demos</a>
        <a href="/#elegir">Elegir</a>
        <a href="/#comparar">Comparar</a>
        <a href="/#como-funciona">Cómo funciona</a>
      </nav>
    </details>
  </div>
</header>
<script is:inline>
  (() => {
    const buttons = [...document.querySelectorAll("[data-theme-choice]")];
    const themeColors = { dark: "#0b0b0c", light: "#f5f7f8", cyan: "#062e38" };
    const sync = (theme) => {
      buttons.forEach((button) => {
        button.setAttribute(
          "aria-pressed",
          String(button.dataset.themeChoice === theme),
        );
      });
    };
    sync(document.documentElement.dataset.theme);
    buttons.forEach((button) =>
      button.addEventListener("click", () => {
        const requested = button.dataset.themeChoice;
        if (!Object.hasOwn(themeColors, requested)) return;
        let theme = requested;
        try {
          localStorage.setItem("evaas-commerce-theme", theme);
        } catch {
          theme = "dark";
        }
        document.documentElement.dataset.theme = theme;
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute("content", themeColors[theme]);
        sync(theme);
      }),
    );
  })();
</script>
