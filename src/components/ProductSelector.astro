<div class="selector-shell" data-selector>
  <div class="selector-intro">
    <span class="eyebrow">Selector simple</span>
    <h2>Encuentra tu punto de partida.</h2>
    <p>Tres preguntas breves. Sin diagnóstico, sin tecnicismos y sin pedir tus datos.</p>
    <div class="selector-progress" aria-hidden="true"><i class="active"></i><i></i><i></i></div>
  </div>
  <div class="selector-body" aria-live="polite">
    <section class="selector-step active" data-step="1">
      <small>Pregunta 1 de 3</small>
      <h3>¿Qué necesitas mostrar principalmente?</h3>
      <div class="selector-options">
        <button class="selector-option" type="button" data-value="landing"><b>Una propuesta principal</b><span>Servicio, campaña o profesional</span></button>
        <button class="selector-option" type="button" data-value="catalogo"><b>Varios productos o servicios</b><span>Para recorrer y consultar</span></button>
        <button class="selector-option" type="button" data-value="corporativa"><b>Una empresa u organización</b><span>Con más contexto institucional</span></button>
      </div>
    </section>
    <section class="selector-step" data-step="2">
      <small>Pregunta 2 de 3</small>
      <h3>¿Cuánta profundidad necesita tu presencia?</h3>
      <div class="selector-options">
        <button class="selector-option" type="button" data-value="landing"><b>Una página breve</b><span>Todo en un recorrido directo</span></button>
        <button class="selector-option" type="button" data-value="catalogo"><b>Una colección organizada</b><span>Hasta 12 ítems</span></button>
        <button class="selector-option" type="button" data-value="corporativa"><b>Varias áreas</b><span>Inicio, empresa, servicios y contacto</span></button>
      </div>
    </section>
    <section class="selector-step" data-step="3">
      <small>Pregunta 3 de 3</small>
      <h3>¿Necesitas una función conectada desde el inicio?</h3>
      <div class="selector-options">
        <button class="selector-option" type="button" data-value="none"><b>No, por ahora</b><span>Quiero presentar mi oferta y recibir consultas</span></button>
        <button class="selector-option" type="button" data-value="ecommerce"><b>Ecommerce o pagos</b><span>Carrito, checkout o pasarela</span></button>
        <button class="selector-option" type="button" data-value="integration"><b>Otra integración</b><span>Agenda, reservas, ERP/CRM, API o automatización</span></button>
      </div>
    </section>
    <section class="selector-result" data-result>
      <span class="result-label">Tu mejor punto de partida</span>
      <h3 data-result-name>Landing Comercial</h3>
      <p data-result-copy></p>
      <strong class="price" data-result-price></strong>
      <a class="button button-dark" data-result-link href="/activar/landing" data-track="product_selected" data-product="landing">Elegir esta opción</a>
      <br />
      <button class="selector-reset" type="button">Volver a responder</button>
    </section>
    <section class="selector-result" data-out-result>
      <div class="selector-out">
        <span class="result-label">Evaluación asistida</span>
        <h3>Esta necesidad requiere una solución asistida.</h3>
        <p>Las activaciones base no incluyen ecommerce ni integraciones. Podemos revisar contigo qué necesitas y definir el alcance antes de construirlo.</p>
        <p class="selector-starting-point" data-starting-point></p>
        <a class="button button-dark" data-assisted-whatsapp data-track="whatsapp_opened" hidden>Conversar por WhatsApp</a>
        <a class="button button-dark" data-assisted-email hidden>Conversar por correo</a>
        <p class="muted" data-assisted-unavailable hidden>El canal directo no está disponible temporalmente.</p>
        <p><a class="text-link" href="/#comparar">Ver qué incluyen las activaciones base</a></p>
        <button class="selector-reset" type="button">Volver a responder</button>
      </div>
    </section>
  </div>
</div>

<script>
  import { products } from '../data/products';
  import { buildAdvancedNeedMessage, buildWhatsAppUrl, getSalesEmail, getWhatsAppConfig, type AdvancedProjectNeed } from '../lib/whatsapp';

  const selector = document.querySelector<HTMLElement>('[data-selector]');
  if (selector) {
    const steps = [...selector.querySelectorAll<HTMLElement>('[data-step]')];
    const bars = [...selector.querySelectorAll<HTMLElement>('.selector-progress i')];
    const result = selector.querySelector<HTMLElement>('[data-result]')!;
    const outResult = selector.querySelector<HTMLElement>('[data-out-result]')!;
    const answers: string[] = [];
    let current = 0;

    const showStep = (index: number) => {
      steps.forEach((step, i) => step.classList.toggle('active', i === index));
      bars.forEach((bar, i) => bar.classList.toggle('active', i <= index));
    };

    const reset = () => {
      answers.length = 0;
      current = 0;
      result.classList.remove('active');
      outResult.classList.remove('active');
      bars.forEach((bar, i) => bar.classList.toggle('active', i === 0));
      showStep(0);
    };

    const inferProduct = () => {
      const scores: Record<string, number> = { landing: 0, catalogo: 0, corporativa: 0 };
      answers.slice(0, 2).forEach((answer) => { if (scores[answer] !== undefined) scores[answer] += 1; });
      const slug = Object.entries(scores).sort((a, b) => b[1] - a[1])[0][0] as 'landing' | 'catalogo' | 'corporativa';
      return products.find((item) => item.slug === slug)!;
    };

    const complete = () => {
      steps.forEach((step) => step.classList.remove('active'));
      bars.forEach((bar) => bar.classList.add('active'));
      const product = inferProduct();
      const need = answers[2];
      if (need === 'ecommerce' || need === 'integration') {
        const startingPoint = selector.querySelector<HTMLElement>('[data-starting-point]')!;
        startingPoint.textContent = `Punto de partida identificado: ${product.name}`;
        const whatsappLink = selector.querySelector<HTMLAnchorElement>('[data-assisted-whatsapp]')!;
        const emailLink = selector.querySelector<HTMLAnchorElement>('[data-assisted-email]')!;
        const unavailable = selector.querySelector<HTMLElement>('[data-assisted-unavailable]')!;
        const whatsapp = getWhatsAppConfig();
        const message = buildAdvancedNeedMessage(need as AdvancedProjectNeed, product.slug);
        const url = whatsapp ? buildWhatsAppUrl(whatsapp.number, message) : null;
        const salesEmail = getSalesEmail();
        whatsappLink.hidden = !url;
        emailLink.hidden = Boolean(url) || !salesEmail;
        unavailable.hidden = Boolean(url) || Boolean(salesEmail);
        if (url) {
          whatsappLink.href = url;
          whatsappLink.dataset.product = product.slug;
        } else if (salesEmail) {
          emailLink.href = `mailto:${salesEmail}?subject=${encodeURIComponent('Evaluación asistida EVAAS Commerce')}`;
        }
        outResult.classList.add('active');
        window.evaasTrack?.('selector_completed', { outcome: need === 'ecommerce' ? 'ecommerce_assisted' : 'integration_assisted' });
        return;
      }

      selector.querySelector<HTMLElement>('[data-result-name]')!.textContent = product.name;
      selector.querySelector<HTMLElement>('[data-result-copy]')!.textContent = product.purpose;
      selector.querySelector<HTMLElement>('[data-result-price]')!.textContent = `$${new Intl.NumberFormat('es-CL').format(product.finalPrice)} · Valor final · boleta o factura`;
      const link = selector.querySelector<HTMLAnchorElement>('[data-result-link]')!;
      link.href = `/activar/${product.slug}`;
      link.dataset.product = product.slug;
      result.classList.add('active');
      window.evaasTrack?.('selector_completed', { outcome: product.slug });
    };

    selector.querySelectorAll<HTMLButtonElement>('.selector-option').forEach((button) => {
      button.addEventListener('click', () => {
        answers[current] = button.dataset.value!;
        if (current < 2) {
          current += 1;
          showStep(current);
          return;
        }
        complete();
      });
    });
    selector.querySelectorAll('.selector-reset').forEach((button) => button.addEventListener('click', reset));
  }
</script>
