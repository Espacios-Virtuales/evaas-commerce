---
import {
  getCommercialEmail,
  getCommercialWhatsApp,
  getOfficialSite,
  getOfficialSocialChannels
} from '../lib/public-channels';

const officialSite = getOfficialSite();
const officialChannels = getOfficialSocialChannels();
const commercialEmail = getCommercialEmail();
const commercialWhatsApp = getCommercialWhatsApp();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-identity">
      <a class="brand" href="/" aria-label="EVAAS Station">
        <span class="brand-mark" aria-hidden="true"><i></i><b></b></span>
        <span><strong>EVAAS</strong><em>Station</em></span>
      </a>
      <p class="footer-description">EVAAS Commerce es la experiencia comercial de <strong>ESPACIOS VIRTUALES SpA</strong>. EVAAS Station reúne sus activaciones digitales.<span>RUT 78.428.352-6</span></p>
      <p class="footer-belief">Empieza y luego crece.</p>
    </div>

    {(officialSite || commercialEmail || commercialWhatsApp) && <nav class="footer-nav" aria-label="Contacto comercial">
      <h2>Espacios Virtuales</h2>
      {officialSite && <a href={officialSite.href} target={officialSite.external ? '_blank' : undefined} rel={officialSite.external ? 'noopener noreferrer' : undefined}>{officialSite.label}</a>}
      {commercialEmail && <a href={commercialEmail.href}>{commercialEmail.address}</a>}
      {commercialWhatsApp && <a href={commercialWhatsApp.href} target="_blank" rel="noopener noreferrer">WhatsApp</a>}
    </nav>}

    {officialChannels.length > 0 && <nav class="footer-nav footer-social" aria-label="Canales oficiales">
      <h2>Canales oficiales</h2>
      {officialChannels.map((channel) => <a href={channel.href} target={channel.external ? '_blank' : undefined} rel={channel.external ? 'noopener noreferrer' : undefined}>
        {channel.id === 'linkedin' && <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false"><path d="M5.2 3.5a2.2 2.2 0 1 1 0 4.4 2.2 2.2 0 0 1 0-4.4ZM3.4 9.5H7v11H3.4v-11Zm5.9 0h3.5V11h.1c.5-.9 1.7-1.9 3.5-1.9 3.8 0 4.5 2.5 4.5 5.7v5.7h-3.7v-5.1c0-1.2 0-2.8-1.8-2.8s-2.1 1.3-2.1 2.7v5.2H9.3v-11Z" /></svg>}
        {channel.id === 'instagram' && <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false"><rect x="3.2" y="3.2" width="17.6" height="17.6" rx="5" fill="none" stroke="currentColor" stroke-width="2" /><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2" /><circle cx="17.7" cy="6.5" r="1.2" /></svg>}
        {channel.id === 'facebook' && <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false"><path d="M13.5 21v-8h2.7l.4-3.1h-3.1v-2c0-.9.3-1.5 1.6-1.5h1.7V3.6c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v2.1H7.3V13h2.8v8h3.4Z" /></svg>}
        {channel.id === 'youtube' && <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false"><path d="M21.6 7.1a2.8 2.8 0 0 0-2-2C17.8 4.6 12 4.6 12 4.6s-5.8 0-7.6.5a2.8 2.8 0 0 0-2 2A29 29 0 0 0 2 12a29 29 0 0 0 .4 4.9 2.8 2.8 0 0 0 2 2c1.8.5 7.6.5 7.6.5s5.8 0 7.6-.5a2.8 2.8 0 0 0 2-2A29 29 0 0 0 22 12a29 29 0 0 0-.4-4.9ZM10 15.2V8.8l5.5 3.2-5.5 3.2Z" /></svg>}
        <span>{channel.label}</span>
      </a>)}
    </nav>}

    <nav class="footer-nav" aria-label="Enlaces legales">
      <h2>Legal</h2>
      <a href="/terminos">Alcance y condiciones</a>
      <a href="/privacidad">Privacidad</a>
    </nav>
  </div>
  <div class="container footer-base">
    <span>© {new Date().getFullYear()} Espacios Virtuales</span>
    <span>Claro · Simple · Evolutivo</span>
  </div>
</footer>
