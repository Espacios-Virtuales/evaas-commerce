---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSalesEmail, getWhatsAppConfig } from '../lib/whatsapp';

const whatsapp = getWhatsAppConfig();
const salesEmail = getSalesEmail();
export const prerender = true;
---

<BaseLayout title="Solicitud preparada · EVAAS Station" noindex>
  <div class="container">
    <section class="success-card">
      <span class="success-mark" aria-hidden="true">✓</span>
      <span class="eyebrow">Solicitud preparada</span>
      <h1>Tu punto de partida está listo.</h1>
      <p>Continúa por WhatsApp para enviarnos este punto de partida y coordinar los siguientes pasos. No compres dominio ni contrates servicios adicionales hasta confirmarlos con una persona.</p>
      <div class="confirmation-contact">
        {whatsapp && <p>Al pulsar el botón abrirás WhatsApp con el brief listo. Revisa el mensaje y pulsa Enviar para compartirlo.</p>}
        {whatsapp
          ? <a class="button button-secondary" data-post-form-whatsapp data-whatsapp-number={whatsapp.number} data-track="whatsapp_post_form_opened" target="_blank" rel="noopener noreferrer" hidden>Continuar por WhatsApp</a>
          : salesEmail
            ? <p class="muted">El canal de WhatsApp no está disponible temporalmente. <a href={`mailto:${salesEmail}`}>Puedes contactarnos por correo: {salesEmail}.</a></p>
            : <p class="muted">El canal directo no está disponible temporalmente.</p>}
      </div>
      <p class="muted" data-request-reference></p>
      <a class="button" href="/">Volver al showroom</a>
      <p class="experience-closing">Empieza y luego crece.</p>
    </section>
  </div>
  <script>
    import { readActivationHandoff } from '../lib/activation-handoff';
    import { buildActivationHandoffMessage, buildPostFormMessage, buildWhatsAppUrl } from '../lib/whatsapp';

    const params = new URLSearchParams(location.search);
    const reference = params.get('id');
    const product = params.get('producto');
    const referenceNode = document.querySelector('[data-request-reference]');
    const validReference = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(reference || '');
    if (validReference && referenceNode) referenceNode.textContent = `Referencia: ${reference!.slice(0, 8).toUpperCase()}`;
    const postFormLink = document.querySelector<HTMLAnchorElement>('[data-post-form-whatsapp]');
    const refreshPostFormLink = () => {
      if (!postFormLink) return;
      const context = window.evaasCommercial?.get();
      const canonicalReference = validReference ? reference!.toLowerCase() : null;
      const handoff = canonicalReference ? readActivationHandoff(canonicalReference, product) : null;
      const matchingContext = context && canonicalReference && context.reference === canonicalReference
        && context.product === product;
      const message = handoff && matchingContext && handoff.product === context.product
        ? buildActivationHandoffMessage(handoff)
        : matchingContext ? buildPostFormMessage(context) : null;
      const url = message ? buildWhatsAppUrl(postFormLink.dataset.whatsappNumber, message) : null;
      if (!url || !context?.product || !context.pricing) {
        postFormLink.hidden = true;
        postFormLink.removeAttribute('href');
        return;
      }
      postFormLink.href = url;
      postFormLink.dataset.product = context.product;
      postFormLink.hidden = false;
    };
    refreshPostFormLink();
    document.addEventListener('evaas:commercial-context-change', refreshPostFormLink);
    postFormLink?.addEventListener('focus', refreshPostFormLink);
    postFormLink?.addEventListener('click', refreshPostFormLink, true);
    window.evaasTrack?.('activation_completed', { product: product || 'unknown', request_id: validReference ? reference : '' });
  </script>
</BaseLayout>
