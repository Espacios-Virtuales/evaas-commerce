---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DemoPreview from '../../components/DemoPreview.astro';
import LandingArchetypeDemo from '../../components/LandingArchetypeDemo.astro';
import CatalogArchetypeDemo from '../../components/CatalogArchetypeDemo.astro';
import ProjectColorSelector from '../../components/ProjectColorSelector.astro';
import { products, formatCLP, type Product } from '../../data/products';
import { INITIAL_PREVIEW_COLOR } from '../../data/project-colors';

export const prerender = true;
export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

interface Props { product: Product }
const { product } = Astro.props;
const isLanding = product.slug === 'landing';
const isCatalog = product.slug === 'catalogo';
---

<BaseLayout title={`Demo ${product.name} · EVAAS Station`} description={`Explora un ejemplo demostrativo de la configuración ${product.name}.`}>
  <header class="page-hero">
    <div class="container">
      <div class="breadcrumb"><a href="/">Inicio</a><span>/</span><span>Demos</span><span>/</span><strong>{product.name}</strong></div>
      <div class="page-hero-grid">
        <div>
          <span class:list={['eyebrow', isCatalog && 'catalog-page-eyebrow']}>{isCatalog ? 'Demo · Diseño y hogar' : `Ejemplo demostrativo · ${product.demoCategory}`}</span>
          <h1 class={isLanding ? 'landing-demo-title' : undefined}>{product.demoName}</h1>
        </div>
        <div class="page-hero-copy">
          <p>{product.demoDescription} {isLanding || isCatalog ? 'Recorre el layout completo y explora su estructura de principio a fin.' : 'Explora el formato, cambia la vista y observa el nivel de profundidad incluido.'}</p>
          <span class="price-line">{product.name} · {formatCLP(product.finalPrice)} final</span>
        </div>
      </div>
    </div>
  </header>

  <section class="demo-workbench" data-demo-page data-demo={product.slug}>
    <div class="container">
      <div class="demo-toolbar">
        {!isLanding && !isCatalog && <div class="segmented" aria-label="Cambiar tamaño de pantalla">
          <button class="active" type="button" data-device="desktop" aria-pressed="true">Escritorio</button>
          <button type="button" data-device="mobile" aria-pressed="false">Móvil</button>
        </div>}
        {product.slug === 'corporativa' && (
          <div class="segmented" aria-label="Navegar ejemplo">
            <button class="active" type="button" data-panel-target="inicio">Inicio</button>
            <button type="button" data-panel-target="empresa">Empresa</button>
            <button type="button" data-panel-target="servicios">Servicios</button>
          </div>
        )}
        <span class="demo-disclaimer">{isLanding || isCatalog ? 'Sitio completo · contenido demostrativo' : 'Ejemplo de estructura y dirección visual'}</span>
      </div>
      <ProjectColorSelector
        name={`demo-${product.slug}-project-color`}
        previewTarget={isLanding ? '[data-landing-demo]' : isCatalog ? '[data-catalog-demo]' : '[data-demo-page] [data-device-frame]'}
      />
      {isLanding ? <LandingArchetypeDemo /> : isCatalog ? <CatalogArchetypeDemo /> : (
        <div class="demo-canvas">
          <div
            class="demo-device"
            data-device-frame
            data-project-color={INITIAL_PREVIEW_COLOR.id}
            style={`--project-accent: ${INITIAL_PREVIEW_COLOR.cssValue}; --project-accent-contrast: ${INITIAL_PREVIEW_COLOR.textColor}`}
          >
            <DemoPreview type={product.slug} expanded />
          </div>
        </div>
      )}

      <div class="demo-detail">
        <div>
          <span class="eyebrow">Lo que esta demo demuestra</span>
          <h2>{isLanding ? 'Un recorrido completo para una propuesta clara.' : isCatalog ? 'Exploración y consulta, sin ecommerce.' : 'Una referencia concreta, no una promesa literal.'}</h2>
        </div>
        <div>
          <p>{isLanding ? 'Esta cafetería y su contenido son ficticios. La estructura ayuda a imaginar una página enfocada en una propuesta principal; el resultado de cada proyecto se define con su propio contenido y alcance.' : isCatalog ? 'Este ejemplo ficticio reúne categorías, fichas y detalles para mostrar cómo se organiza una colección. El CTA de consulta solo conduce a la sección ilustrativa; no conecta canales ni servicios reales. La estructura final se define con el contenido de cada proyecto y no promete una copia exacta.' : `Tu resultado usará tu contenido, tu nombre y una dirección visual definida para tu proyecto. La demo muestra el tipo de recorrido y la profundidad posible dentro de ${product.name}; no garantiza una copia exacta ni capacidades fuera del alcance.`}</p>
          {!isLanding && !isCatalog && <ul>
            <li><strong>Formato:</strong> {product.scope}</li>
            <li><strong>Interacción útil:</strong> adaptación móvil y exploración del contenido.</li>
            <li><strong>Personalización:</strong> color, tipografía, mensajes e identidad básica.</li>
          </ul>}
        </div>
      </div>
      <div class="demo-cta">
        <div>
          {(isLanding || isCatalog) && <span class="eyebrow">EVAAS · Configuración</span>}
          <strong>{isLanding ? '¿Una página directa se parece a lo que necesitas?' : isCatalog ? '¿Una colección organizada se parece a lo que necesitas?' : '¿Este nivel de presencia se parece a lo que necesitas?'}</strong>
          <p>Puedes revisar el alcance completo antes de comenzar.</p>
          {(isLanding || isCatalog) && <div class="demo-return-links"><a href={`/productos/${product.slug}`}>Revisar producto</a><a href="/#showroom">Volver al showroom</a></div>}
        </div>
        <a class="button" href={`/activar/${product.slug}`} data-track="demo_completed" data-demo={product.slug} data-product={product.slug}>{isLanding ? 'Elegir Landing' : isCatalog ? 'Elegir Catálogo' : 'Quiero comenzar con esta estructura'}</a>
      </div>
    </div>
  </section>

  <script>
    // @ts-nocheck -- dataset-driven controls are guarded by the demo-page container.
    const demoPage = document.querySelector('[data-demo-page]');
    if (demoPage) {
      const slug = demoPage.dataset.demo;
      const frame = demoPage.querySelector('[data-device-frame]');
      let interactions = 0;
      let completed = false;
      window.evaasTrack?.('demo_opened', { demo: slug });

      const recordInteraction = () => {
        interactions += 1;
        if (!completed && interactions >= 2) {
          completed = true;
          window.evaasTrack?.('demo_completed', { demo: slug, method: 'interaction' });
        }
      };

      demoPage.querySelectorAll('[data-device]').forEach((button) => button.addEventListener('click', () => {
        demoPage.querySelectorAll('[data-device]').forEach((item) => {
          item.classList.toggle('active', item === button);
          item.setAttribute('aria-pressed', item === button ? 'true' : 'false');
        });
        frame.classList.toggle('mobile', button.dataset.device === 'mobile');
        recordInteraction();
      }));

      demoPage.addEventListener('evaas:project-color-change', recordInteraction);

      demoPage.querySelectorAll('[data-panel-target]').forEach((button) => button.addEventListener('click', () => {
        demoPage.querySelectorAll('[data-panel-target]').forEach((item) => item.classList.toggle('active', item === button));
        demoPage.querySelectorAll('[data-panel]').forEach((panel) => panel.classList.toggle('active', panel.dataset.panel === button.dataset.panelTarget));
        recordInteraction();
      }));

    }
  </script>
</BaseLayout>

<style>
  .page-hero .catalog-page-eyebrow { position: relative; display: block; max-width: 100%; padding-left: 2.35rem; line-height: 1.5; }
  .page-hero .catalog-page-eyebrow::before { position: absolute; top: .72em; left: 0; }
</style>
