---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DemoPreview from '../../components/DemoPreview.astro';
import LandingArchetypeDemo from '../../components/LandingArchetypeDemo.astro';
import CatalogArchetypeDemo from '../../components/CatalogArchetypeDemo.astro';
import CorporateArchetypeDemo from '../../components/CorporateArchetypeDemo.astro';
import ProjectColorSelector from '../../components/ProjectColorSelector.astro';
import { products, commonClientInputs, formatCLP, type Product } from '../../data/products';
import { INITIAL_PREVIEW_COLOR } from '../../data/project-colors';

export const prerender = true;
export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

interface Props { product: Product }
const { product } = Astro.props;
const isLanding = product.slug === 'landing';
const isCatalog = product.slug === 'catalogo';
const isCorporate = product.slug === 'corporativa';
---

<BaseLayout title={`Demo ${product.name} · EVAAS Station`} description={`Explora un ejemplo demostrativo de la configuración ${product.name}.`}>
  <header class="page-hero">
    <div class="container">
      <div class="breadcrumb"><a href="/">Inicio</a><span>/</span><span>Demos</span><span>/</span><strong>{product.name}</strong></div>
      <div class="page-hero-grid">
        <div>
          <span class="eyebrow">DEMO DE PRODUCTO · {product.name.toUpperCase()}</span>
          <h1>{product.name}</h1>
        </div>
        <div class="page-hero-copy">
          <p>{product.purpose}</p>
          <span class="price-line">Valor · {formatCLP(product.finalPrice)} IVA incluido</span>
          <small>Neto {formatCLP(product.netPrice)} + IVA</small>
          <a class="button demo-hero-cta" href={`/activar/${product.slug}`} data-track="product_selected" data-product={product.slug}>Elegir {product.name}</a>
          <small>Ejemplo aplicado: {product.demoCategory.toLowerCase()}.</small>
        </div>
      </div>
    </div>
  </header>

  <section class="demo-workbench" data-demo-page data-demo={product.slug}>
    <div class="container">
      <div class="demo-toolbar">
        <span class="demo-disclaimer">Demo interior · marca y contenido ficticios</span>
      </div>
      <ProjectColorSelector
        name={`demo-${product.slug}-project-color`}
        previewTarget={isLanding ? '[data-landing-demo]' : isCatalog ? '[data-catalog-demo]' : isCorporate ? '[data-corporate-demo]' : '[data-demo-page] [data-device-frame]'}
      />
      {isLanding ? <LandingArchetypeDemo /> : isCatalog ? <CatalogArchetypeDemo /> : isCorporate ? <CorporateArchetypeDemo /> : (
        <div class="demo-canvas">
          <div
            class="demo-device"
            data-device-frame
            data-project-color={INITIAL_PREVIEW_COLOR.id}
            style={`--project-accent: ${INITIAL_PREVIEW_COLOR.cssValue}; --project-accent-contrast: ${INITIAL_PREVIEW_COLOR.textColor}`}
          >
            <DemoPreview type={product.slug} expanded />
          </div>
        </div>
      )}

      <div class="demo-detail client-inputs">
        <div>
          <span class="eyebrow">Preparación del cliente</span>
          <h2>¿Qué necesitas para comenzar?</h2>
        </div>
        <div>
          <p>Si ya los tienes, necesitaremos algunos materiales para construir {product.name} dentro del alcance:</p>
          <ul>{commonClientInputs.map((item) => <li>{item}</li>)}{product.clientInputs.map((item) => <li>{item}</li>)}{product.additionalInputs.map((item) => <li>{item}</li>)}</ul>
          <aside class="additional-scope-note"><strong>¿No tienes alguno de estos materiales?</strong><p>Podemos ayudarte a desarrollarlos como alcance adicional. Se cotizan y aprueban por separado antes de incorporarlos. Crear o reformular branding, logo, propuesta de valor y textos desde cero no forma parte automática del producto base. La producción fotográfica no está incluida.</p></aside>
        </div>
      </div>
      <div class="demo-cta">
        <div>
          <span class="eyebrow">EVAAS · Producto</span>
          <strong>¿Quieres comenzar con {product.name}?</strong>
          <p>Valor · {formatCLP(product.finalPrice)} IVA incluido. Revisa el alcance completo antes de activar.</p>
          <div class="demo-return-links"><a href={`/productos/${product.slug}`}>Revisar producto</a><a href="/#showroom">Volver al showroom</a></div>
        </div>
        <a class="button" href={`/activar/${product.slug}`} data-track="demo_completed" data-demo={product.slug} data-product={product.slug}>Elegir {product.name}</a>
      </div>
    </div>
  </section>

  <script>
    // @ts-nocheck -- dataset-driven controls are guarded by the demo-page container.
    const demoPage = document.querySelector('[data-demo-page]');
    if (demoPage) {
      const slug = demoPage.dataset.demo;
      let interactions = 0;
      let completed = false;
      window.evaasTrack?.('demo_opened', { demo: slug });

      const recordInteraction = () => {
        interactions += 1;
        if (!completed && interactions >= 2) {
          completed = true;
          window.evaasTrack?.('demo_completed', { demo: slug, method: 'interaction' });
        }
      };

      demoPage.addEventListener('evaas:project-color-change', recordInteraction);
    }
  </script>
</BaseLayout>

<style>
  .page-hero .archetype-page-eyebrow { position: relative; display: block; max-width: 100%; padding-left: 2.35rem; line-height: 1.5; }
  .page-hero .archetype-page-eyebrow::before { position: absolute; top: .72em; left: 0; }
</style>
