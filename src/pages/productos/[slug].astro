---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductArchetypeIcon from '../../components/ProductArchetypeIcon.astro';
import { products, commonClientInputs, formatCLP, type Product } from '../../data/products';

export const prerender = true;
export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}
interface Props { product: Product }
const { product } = Astro.props;
---

<BaseLayout title={`${product.name} · EVAAS Station`} description={product.purpose}>
  <header class="page-hero">
    <div class="container">
      <div class="breadcrumb"><a href="/">Inicio</a><span>/</span><span>Productos</span><span>/</span><strong>{product.name}</strong></div>
      <div class="page-hero-grid">
        <div><ProductArchetypeIcon type={product.slug} /><span class="eyebrow">{product.eyebrow}</span><h1>{product.name}</h1></div>
        <div class="page-hero-copy"><p>{product.purpose}</p><span class="price-line">Valor · {formatCLP(product.finalPrice)} IVA incluido</span><small>Neto {formatCLP(product.netPrice)} + IVA</small></div>
      </div>
    </div>
  </header>

  <section class="section-tight">
    <div class="container product-detail-grid">
      <div class="product-information">
        <section class="scope-panel">
          <span class="eyebrow">Alcance definido</span>
          <h2>Qué recibes</h2>
          <p>{product.scope}</p>
          <ul class="scope-list">{product.includes.map((item) => <li>{item}</li>)}</ul>
        </section>
        <section class="scope-panel client-input-panel">
          <span class="eyebrow">Preparación del cliente</span>
          <h2>¿Qué necesitas para comenzar?</h2>
          <p>Si ya los tienes, necesitaremos estos materiales para construir el producto dentro del alcance:</p>
          <ul class="scope-list">{commonClientInputs.map((item) => <li>{item}</li>)}{product.clientInputs.map((item) => <li>{item}</li>)}</ul>
          {product.additionalInputs.length > 0 && <ul class="scope-list">{product.additionalInputs.map((item) => <li>{item}</li>)}</ul>}
          <aside class="additional-scope-note"><strong>¿No tienes alguno de estos materiales?</strong><p>Podemos ayudarte a desarrollarlos como alcance adicional. Se cotizan y aprueban por separado antes de incorporarlos. Crear o reformular branding, logo, propuesta de valor y textos desde cero no forma parte automática del producto base; la producción fotográfica tampoco está incluida.</p></aside>
        </section>
        <section class="scope-panel">
          <span class="eyebrow">Límites claros</span>
          <h2>Qué no incluye</h2>
          <ul class="scope-list">{product.excludes.map((item) => <li>{item}</li>)}</ul>
          <p class="not-included">Las necesidades fuera de este alcance se cotizan y aprueban por separado.</p>
        </section>
      </div>
      <aside class="sticky-purchase">
        <span class="eyebrow eyebrow-dark">Producto EVAAS</span>
        <h2>{product.shortPurpose}</h2>
        <strong class="price-big">{formatCLP(product.finalPrice)}</strong>
        <span class="tax-copy">Valor · IVA incluido · neto {formatCLP(product.netPrice)} + IVA</span>
        <ul>
          <li>{product.scope}</li>
          <li>Tu contenido dentro del alcance</li>
          <li>Responsive y publicación inicial</li>
        </ul>
        <a class="button button-dark button-wide" href={`/activar/${product.slug}`} data-track="product_selected" data-product={product.slug}>Elegir {product.name}</a>
        <a class="text-link product-demo-link" href={`/demos/${product.slug}`} data-track="demo_opened" data-demo={product.slug}>Ver demo →</a>
        <div class="control-note"><strong>Tu dominio sigue siendo tuyo.</strong><br />Tú lo compras y conservas; nosotros lo conectamos.</div>
      </aside>
    </div>
  </section>
</BaseLayout>
