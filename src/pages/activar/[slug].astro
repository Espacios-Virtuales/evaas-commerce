---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { products, formatCLP, type Product } from '../../data/products';
import { PROJECT_CATEGORIES } from '../../data/project-categories';

export const prerender = true;
export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}
interface Props { product: Product }
const { product } = Astro.props;
---

<BaseLayout title={`Activar ${product.name} · EVAAS Station`} description={`Comienza tu activación digital ${product.name}.`} noindex>
  <div class="container activation-layout" data-activation-page data-product={product.slug} data-product-name={product.name}>
    <aside class="activation-summary">
      <span class="eyebrow">Tu selección</span>
      <h1>{product.name}</h1>
      <span class="summary-price" data-commercial-price>{formatCLP(product.finalPrice)}</span>
      <span class="muted" data-commercial-price-note>Valor final · boleta o factura</span>
      <p class="campaign-preview" data-campaign-preview hidden></p>
      <span class="muted" data-commercial-project-color>Color del proyecto · Por definir</span>
      <ul>
        <li>{product.scope}</li>
        <li>Aplicación básica de tu identidad disponible y responsive</li>
        <li>Publicación inicial en Vercel*</li>
        <li>Conexión de tu dominio</li>
        <li>Sin ecommerce</li>
      </ul>
      <a href={`/productos/${product.slug}`}>Revisar alcance completo</a>
    </aside>

    <section class="activation-panel">
      <span class="eyebrow eyebrow-dark">Comenzar activación</span>
      <h2>Lo esencial para comenzar.</h2>
      <p>Tus respuestas preparan la solicitud. No te pediremos textos finales ni accesos en esta etapa.</p>
      <div class="form-progress" aria-hidden="true"><span class="active"></span><span></span></div>

      <form method="post" action="/api/activation" data-activation-form>
        <input type="hidden" name="product" value={product.slug} />
        <input type="hidden" name="projectColor" value="" />
        <input type="hidden" name="formStartedAt" value="" />
        <div class="honeypot" aria-hidden="true"><label>Empresa web <input name="website" tabindex="-1" autocomplete="off" /></label></div>

        <div class="form-step active" data-form-step="1">
          <h3>1. Tu proyecto</h3>
          <div class="field-grid">
            <div class="field field-full">
              <label for="project">Nombre del proyecto o negocio</label>
              <input id="project" name="project" required maxlength="100" autocomplete="organization" placeholder="Ej. Mi negocio" />
            </div>
            <div class="field field-full">
              <label for="projectCategory">¿A qué se dedica principalmente tu proyecto?</label>
              <select id="projectCategory" name="projectCategory" required>
                <option value="">Selecciona una categoría</option>
                {PROJECT_CATEGORIES.map((category) => <option value={category.id}>{category.label}</option>)}
              </select>
            </div>
            <fieldset class="field field-full" style="border:0;padding:0;margin:0">
              <legend>¿Ya tienes dominio?</legend>
              <div class="radio-grid">
                <div class="radio-card"><input id="domain-yes" type="radio" name="domainStatus" value="owned" required /><label for="domain-yes"><strong>Sí</strong><span>Ya es mío</span></label></div>
                <div class="radio-card"><input id="domain-no" type="radio" name="domainStatus" value="needed" /><label for="domain-no"><strong>No</strong><span>Necesito comprarlo</span></label></div>
                <div class="radio-card"><input id="domain-unsure" type="radio" name="domainStatus" value="unsure" /><label for="domain-unsure"><strong>No sé</strong><span>Necesito orientación</span></label></div>
              </div>
              <small>El dominio lo compras y conservas tú. Te ayudamos a conectarlo.</small>
            </fieldset>
            <div class="field field-full">
              <label for="campaignCode">Código promocional</label>
              <input id="campaignCode" name="campaignCode" maxlength="32" autocomplete="off" autocapitalize="characters" placeholder="Ej. CIBERDAY" />
              <small>Si tienes un código vigente, ingrésalo para previsualizar el valor final.</small>
              <div class="campaign-status" data-campaign-status role="status" aria-live="polite"></div>
            </div>
            <div class="field field-full">
              <label for="context">¿Qué necesitas que una persona entienda o haga?</label>
              <textarea id="context" name="context" maxlength="600" placeholder="Ej. Conocer mis servicios y solicitar una hora."></textarea>
              <small>Una frase es suficiente. Podrás completar la información después.</small>
            </div>
          </div>
          <div class="form-actions"><span></span><button class="button button-dark" type="button" data-enhanced-control data-next>Continuar</button></div>
        </div>

        <div class="form-step" data-form-step="2">
          <h3>2. Revisión y consentimiento</h3>
          <p class="muted" style="margin-top:.6rem">Verifica el punto de partida. El alcance definitivo se mantiene en la configuración elegida.</p>
          <div class="review-box" data-review hidden></div>
          <div class="checkbox">
            <input id="consent" name="consent" type="checkbox" required />
            <label for="consent">Acepto que Espacios Virtuales use estos datos para preparar esta solicitud y abrir WhatsApp con el brief listo para que yo decida enviarlo. Leí el <a href="/privacidad" target="_blank">aviso de privacidad</a> y los <a href="/terminos" target="_blank">términos de activación</a>.</label>
          </div>
          <div class="form-status" data-form-status role="status" aria-live="polite"></div>
          <div class="form-actions"><button class="button-plain" type="button" data-enhanced-control data-back>Volver</button><button class="button button-dark" type="submit">Preparar solicitud</button></div>
        </div>
      </form>
    </section>
  </div>

  <script>
    // @ts-nocheck -- form controls and Astro serialized values are runtime DOM values.
    import { isCanonicalUuid } from '../../lib/commercial-context';
    import { normalizeCampaignCode, resolveCampaign, resolvePromotionalPricing } from '../../data/campaigns';
    import { getProjectCategoryLabel, sanitizeActivationHandoff, storeActivationHandoff } from '../../lib/activation-handoff';
    import { buildActivationHandoffMessage, buildWhatsAppUrl, getWhatsAppConfig } from '../../lib/whatsapp';
    import type { ProjectCategory } from '../../data/project-categories';

    const page = document.querySelector('[data-activation-page]');
    const form = page?.querySelector('[data-activation-form]');
    if (form) {
      const productName = page.dataset.productName;
      const productSlug = page.dataset.product;
      const steps = [...form.querySelectorAll('[data-form-step]')];
      const progress = [...page.querySelectorAll('.form-progress span')];
      const status = form.querySelector('[data-form-status]');
      const review = form.querySelector('[data-review]');
      const campaignInput = form.elements.campaignCode;
      const campaignStatus = form.querySelector('[data-campaign-status]');
      const priceNode = page.querySelector('[data-commercial-price]');
      const priceNote = page.querySelector('[data-commercial-price-note]');
      const campaignPreview = page.querySelector('[data-campaign-preview]');
      let current = 0;
      let submitting = false;
      form.elements.formStartedAt.value = String(Date.now());
      window.evaasTrack?.('activation_started', { product: productSlug });

      const formatPrice = (value) => `$${new Intl.NumberFormat('es-CL').format(value)}`;
      const renderPricing = (pricing) => {
        priceNode.textContent = formatPrice(pricing.total);
        if (pricing.campaignCode) {
          priceNote.textContent = `Valor final con ${pricing.campaignCode} · boleta o factura`;
          campaignPreview.textContent = `${pricing.campaignCode} aplicado · 15% de descuento · Ahorras ${formatPrice(pricing.discountAmount)}.`;
          campaignPreview.hidden = false;
        } else {
          priceNote.textContent = 'Valor final · boleta o factura';
          campaignPreview.hidden = true;
        }
      };
      const applyCampaign = () => {
        const rawCode = campaignInput.value;
        const normalizedCode = normalizeCampaignCode(rawCode);
        campaignStatus.textContent = '';
        campaignStatus.className = 'campaign-status';
        campaignInput.removeAttribute('aria-invalid');
        if (!normalizedCode) {
          window.evaasCommercial?.setCampaignCode(null);
          renderPricing(resolvePromotionalPricing(productSlug));
          return true;
        }
        campaignInput.value = normalizedCode;
        const campaign = resolveCampaign(normalizedCode);
        if (!campaign) {
          window.evaasCommercial?.setCampaignCode(null);
          renderPricing(resolvePromotionalPricing(productSlug));
          campaignInput.setAttribute('aria-invalid', 'true');
          campaignStatus.className = 'campaign-status error';
          campaignStatus.textContent = normalizedCode === 'CIBERDAY'
            ? 'El código promocional no está vigente.'
            : 'El código promocional no es válido.';
          return false;
        }
        window.evaasCommercial?.setCampaignCode(campaign.code);
        renderPricing(resolvePromotionalPricing(productSlug, campaign.code));
        return true;
      };
      const urlCampaignCode = new URL(location.href).searchParams.get('campaignCode');
      const contextCampaignCode = window.evaasCommercial?.get()?.campaignCode;
      if (urlCampaignCode || contextCampaignCode) campaignInput.value = urlCampaignCode || contextCampaignCode;
      applyCampaign();
      campaignInput.addEventListener('change', applyCampaign);
      campaignInput.addEventListener('blur', applyCampaign);

      const showStep = (index) => {
        current = index;
        steps.forEach((step, i) => step.classList.toggle('active', i === index));
        progress.forEach((bar, i) => bar.classList.toggle('active', i <= index));
        page.querySelector('.activation-panel')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      };

      const fieldsForStep = (index) => [...steps[index].querySelectorAll('input, textarea, select')].filter((field) => field.type !== 'hidden');
      const validateStep = (index) => {
        for (const field of fieldsForStep(index)) {
          if (!field.checkValidity()) { field.reportValidity(); return false; }
        }
        return true;
      };

      const renderReview = () => {
        const data = new FormData(form);
        const domain = { owned: 'Ya tiene dominio', needed: 'Necesita comprar dominio', unsure: 'Necesita orientación' }[data.get('domainStatus')];
        const values = [
          ['Configuración', productName],
          ['Proyecto', data.get('project')],
          ['Categoría', getProjectCategoryLabel(data.get('projectCategory') as ProjectCategory)],
          ['Dominio', domain]
        ];
        const pricing = resolvePromotionalPricing(productSlug, campaignInput.value);
        if (pricing.campaignCode) values.push(['Promoción', `${pricing.campaignCode} · ${formatPrice(pricing.total)}`]);
        if (data.get('context')) values.push(['Objetivo', data.get('context')]);
        const box = form.querySelector('[data-review]');
        box.replaceChildren(...values.map(([label, value]) => {
          const row = document.createElement('div');
          const key = document.createElement('span');
          const content = document.createElement('strong');
          key.textContent = label;
          content.textContent = value || '—';
          row.append(key, content);
          return row;
        }));
        box.hidden = false;
      };

      form.querySelectorAll('[data-next]').forEach((button) => button.addEventListener('click', () => {
        if (!validateStep(current)) return;
        if (current === 0) renderReview();
        showStep(Math.min(1, current + 1));
      }));
      form.querySelectorAll('[data-back]').forEach((button) => button.addEventListener('click', () => showStep(Math.max(0, current - 1))));

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (submitting || !validateStep(1) || !applyCampaign()) return;
        submitting = true;

        // Keep the user gesture alive while opening a secondary context before the first await.
        const whatsapp = getWhatsAppConfig();
        let whatsappWindow: Window | null = null;
        if (whatsapp) {
          try {
            whatsappWindow = window.open('about:blank', '_blank');
            if (whatsappWindow) {
              whatsappWindow.document.title = 'Preparando WhatsApp';
              whatsappWindow.document.body.textContent = 'Preparando tu brief. Esta pestaña se cerrará si la solicitud no puede completarse.';
              whatsappWindow.opener = null;
            }
          } catch {
            whatsappWindow = null;
          }
        }

        status.className = 'form-status';
        const submit = form.querySelector('[type="submit"]');
        submit.disabled = true;
        submit.textContent = 'Preparando…';
        const data = Object.fromEntries(new FormData(form).entries());
        const commercialContext = window.evaasCommercial?.get();
        data.projectColor = commercialContext?.projectColor || '';
        data.attribution = commercialContext?.attribution || window.evaasAttribution || { source: 'direct', medium: '', campaign: '' };
        try {
          const response = await fetch('/api/activation', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
          });
          const result = await response.json();
          if (!response.ok) throw new Error(result.message || 'No fue posible enviar la solicitud.');
          if (!isCanonicalUuid(result.requestId)) throw new Error('No fue posible validar la referencia. Intenta nuevamente.');

          const requestId = result.requestId.toLowerCase();
          const handoff = sanitizeActivationHandoff(result.handoff);
          const validHandoff = handoff && handoff.reference === requestId && handoff.product === productSlug;
          window.evaasCommercial?.setReference(requestId);
          if (validHandoff) storeActivationHandoff(handoff, requestId);

          const message = validHandoff ? buildActivationHandoffMessage(handoff) : null;
          const whatsappUrl = whatsapp && message ? buildWhatsAppUrl(whatsapp.number, message) : null;
          let whatsappState: 'opened' | 'blocked' | 'unavailable' | 'invalid' = validHandoff ? 'unavailable' : 'invalid';
          if (whatsappUrl && whatsappWindow) {
            try {
              whatsappWindow.location.replace(whatsappUrl);
              whatsappState = 'opened';
              window.evaasTrack?.('whatsapp_post_form_opened', { product: productSlug, mode: 'automatic' });
            } catch {
              try { whatsappWindow.close(); } catch { /* The browser may already have closed the popup. */ }
              whatsappState = 'unavailable';
            }
          } else {
            if (whatsappWindow) {
              try { whatsappWindow.close(); } catch { /* The browser may already have closed the popup. */ }
            }
            whatsappState = !validHandoff ? 'invalid' : !whatsapp ? 'unavailable' : !whatsappWindow ? 'blocked' : 'unavailable';
          }

          if (validHandoff) window.evaasTrack?.('activation_submitted', { product: productSlug, request_id: requestId });
          else window.evaasTrack?.('activation_error', { product: productSlug });
          location.assign(`/confirmacion?producto=${encodeURIComponent(productSlug)}&id=${encodeURIComponent(requestId)}&wa=${whatsappState}`);
        } catch (error) {
          if (whatsappWindow) {
            try { whatsappWindow.close(); } catch { /* The browser may already have closed the popup. */ }
          }
          status.textContent = error.message || 'No fue posible enviar. Intenta nuevamente.';
          status.className = 'form-status error';
          submit.disabled = false;
          submit.textContent = 'Preparar solicitud';
          submitting = false;
          window.evaasTrack?.('activation_error', { product: productSlug });
        }
      });

      // Keep the complete native form available unless every wizard listener is ready.
      form.classList.add('is-enhanced');
      if (review) review.hidden = true;
    }
  </script>
</BaseLayout>
