# C04: configuración pública del showroom. Son slots de build/deploy, no fuentes de autoridad comercial.
# Desarrollo/integración puede usar URLs de prueba; las redes siguientes fueron confirmadas por David para producción.
PUBLIC_EV_SITE_URL=https://espaciosvirtuales.cl
PUBLIC_EV_LINKEDIN_URL=https://www.linkedin.com/company/evaas369/
PUBLIC_EV_INSTAGRAM_URL=https://www.instagram.com/evaas963/
PUBLIC_EV_FACEBOOK_URL=https://www.facebook.com/espaciosvirtuales963/
PUBLIC_EV_YOUTUBE_CHANNEL_URL=https://www.youtube.com/@evaas963

# Contacto comercial de respaldo y destino comercial configurables.
PUBLIC_EV_SALES_EMAIL=info@espaciosvirtuales.lat
# Acepta dígitos o E.164 con +; se valida y normaliza antes de formar wa.me.
PUBLIC_EV_WHATSAPP=56979959180

PUBLIC_EV_YOUTUBE_VIDEO_ID=
PUBLIC_EV_YOUTUBE_VIDEO_URL=
PUBLIC_EV_YOUTUBE_VIDEO_POSTER=

# Video individual de prueba u oficial: habilitar solo con URL e ID coherentes.
PUBLIC_EV_LINKEDIN_ENABLED=true
PUBLIC_EV_INSTAGRAM_ENABLED=true
PUBLIC_EV_FACEBOOK_ENABLED=true
PUBLIC_EV_YOUTUBE_VIDEO_ENABLED=false
